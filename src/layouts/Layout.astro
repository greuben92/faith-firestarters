---
import '../styles/global.css'

export interface Props {
  title?: string
}

const { title } = Astro.props
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title ? `${title} — Faith Firestarters` : 'Faith Firestarters — Bible Study'}</title>
  </head>
  <body class="font-source-serif text-ink">
    <header class="border-b-4 border-double border-gold bg-parchment-dark/50">
      <div class="mx-auto flex max-w-4xl items-center justify-between px-4 py-4">
        <a href="/" class="font-cinzel text-2xl tracking-widest text-ink no-underline hover:text-oxblood">
          Faith Firestarters Bible Study
        </a>
      </div>
    </header>

    <div class="mx-auto max-w-4xl px-4 py-8">
      <main>
        <slot />
      </main>
    </div>

    <footer class="border-t-4 border-double border-gold py-6 text-center font-cinzel text-sm tracking-widest text-ink-light">
      Verbum Domini Manet in Aeternum
    </footer>
  </body>
</html>
