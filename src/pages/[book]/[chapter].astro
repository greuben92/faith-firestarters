---
import Layout from '../../layouts/Layout.astro'
import { getCollection, render } from 'astro:content'

export async function getStaticPaths() {
  const notes = await getCollection('notes')
  return notes.map(entry => ({
    params: {
      book: entry.data.book.toLowerCase().replace(/\s+/g, '-'),
      chapter: String(entry.data.chapter),
    },
    props: { entry },
  }))
}

const { entry } = Astro.props
const { Content } = await render(entry)
const title = `${entry.data.book} ${entry.data.chapter}`
const bookSlug = entry.data.book.toLowerCase().replace(/\s+/g, '-')

const allNotes = await getCollection('notes')
const sameBook = allNotes
  .filter(n => n.data.book === entry.data.book)
  .sort((a, b) => a.data.chapter - b.data.chapter)
const curIdx = sameBook.findIndex(n => n.data.chapter === entry.data.chapter)
const prevEntry = curIdx > 0 ? sameBook[curIdx - 1] : null
const nextEntry = curIdx < sameBook.length - 1 ? sameBook[curIdx + 1] : null
---

<Layout title={title}>
  <div class="mb-6">
    <a href="/" class="font-cinzel text-sm tracking-wider text-ink-light no-underline hover:text-oxblood">
      &larr; Back to Books
    </a>
  </div>

  <article class="prose-custom">
    <header class="mb-8 border-b-2 border-double border-gold pb-4">
      <div class="md:flex md:items-baseline md:justify-between">
        <h1 class="font-cinzel text-4xl tracking-widest text-ink">
          {entry.data.book} <span class="text-gold">{entry.data.chapter}</span>
        </h1>
        <time class="font-cinzel text-sm tracking-wider text-ink-light">
          {entry.data.date}
        </time>
      </div>
    </header>

    <div class="leading-relaxed text-ink [&_h2]:mt-8 [&_h2]:mb-4 [&_h2]:font-cinzel [&_h2]:text-2xl [&_h2]:tracking-wider [&_h3]:mt-6 [&_h3]:mb-3 [&_h3]:font-cinzel [&_h3]:text-xl [&_h3]:tracking-wider [&_p]:mb-4 [&_p]:leading-relaxed [&_ul]:mb-4 [&_ul]:list-disc [&_ul]:pl-6 [&_ol]:mb-4 [&_ol]:list-decimal [&_ol]:pl-6 [&_li]:mb-1 [&_hr]:my-8 [&_hr]:border-gold [&_em]:italic [&_strong]:font-bold [&_blockquote]:border-l-4 [&_blockquote]:border-gold [&_blockquote]:pl-4 [&_blockquote]:italic [&_blockquote]:text-ink-light [&_code]:rounded [&_code]:bg-parchment-dark [&_code]:px-2 [&_code]:py-0.5 [&_code]:font-mono [&_code]:text-sm">
      <Content />
    </div>

    <nav class="mt-12 flex items-center justify-between border-t-2 border-double border-gold pt-6">
      <div>
        {prevEntry && (
          <a
            href={`/${prevEntry.data.book.toLowerCase().replace(/\s+/g, '-')}/${prevEntry.data.chapter}`}
            class="font-cinzel text-sm tracking-wider text-ink-light no-underline hover:text-oxblood"
          >
            &larr; Chapter {prevEntry.data.chapter}
          </a>
        )}
      </div>
      <div>
        {nextEntry && (
          <a
            href={`/${nextEntry.data.book.toLowerCase().replace(/\s+/g, '-')}/${nextEntry.data.chapter}`}
            class="font-cinzel text-sm tracking-wider text-ink-light no-underline hover:text-oxblood"
          >
            Chapter {nextEntry.data.chapter} &rarr;
          </a>
        )}
      </div>
    </nav>
  </article>
</Layout>
